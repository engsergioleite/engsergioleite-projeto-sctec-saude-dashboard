    "header": {
      "color": "#1A2E35",
      "fontFace": "Segoe UI",
      "fontSize": 12
    },
    "label": {
      "color": "#4A5A61",
      "fontFace": "Segoe UI",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E0E6E8" } },
            "radius": 6
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          { "color": { "solid": { "color": "#0E7C7B" } }, "fontSize": 28, "fontFamily": "Segoe UI Semibold" }
        ],
        "categoryLabels": [
          { "color": { "solid": { "color": "#4A5A61" } }, "fontSize": 11 }
        ]
      }
    }
  }
